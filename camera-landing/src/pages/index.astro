<script>
  (function () {
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const video     = document.getElementById('hero-video') as HTMLVideoElement | null;
    const container = document.getElementById('hero') as HTMLElement | null;
    if (!video || !container) return;

    const slides = Array.from(
      container.querySelectorAll<HTMLElement>('.hero-slide')
    );

    /* ── Reduced motion: solo slide 0 visible, sin scroll scrub ── */
    if (prefersReduced) {
      video.loop = true;
      video.play().catch(() => {});
      slides[0]?.classList.add('is-visible');
      return;
    }

    /* ─────────────────────────────────────────────────────────────
       SCROLL SCRUB — lerp adaptativo + decode-gate
       El lerp se escala con el tamaño del delta para que la rueda
       del ratón se sienta tan fluida como arrastrar la barra.
    ───────────────────────────────────────────────────────────── */
    const THRESH = 0.025; // delta mínimo en seg para emitir seek

    let target  = 0;
    let current = 0;
    let seeking = false;
    let raf: number | null = null;

    /* Cuántos slides tenemos y en qué rango de scroll [0..1]
       corresponde cada uno.
       Slide 0: 0.00 – 0.15   (apertura rápida)
       Slide 1: 0.20 – 0.42   (sensor)
       Slide 2: 0.47 – 0.62   (IBIS)
       Slide 3: 0.67 – 0.80   (burst)
       Slide 4: 0.87 – 1.00   (CTA)
    */
    const SLIDE_RANGES: [number, number][] = [
      [0.00, 0.15],
      [0.20, 0.42],
      [0.47, 0.62],
      [0.67, 0.80],
      [0.87, 1.00],
    ];

    let activeSlide = -1;

    function progress(): number {
      const rect  = container!.getBoundingClientRect();
      const range = container!.offsetHeight - window.innerHeight;
      if (range <= 0) return 0;
      return Math.min(Math.max(-rect.top / range, 0), 1);
    }

    function updateSlides(p: number) {
      let next = -1;
      for (let i = 0; i < SLIDE_RANGES.length; i++) {
        const [start, end] = SLIDE_RANGES[i];
        if (p >= start && p <= end) { next = i; break; }
      }

      if (next === activeSlide) return;

      /* ocultar el anterior */
      if (activeSlide >= 0 && slides[activeSlide]) {
        const prev = slides[activeSlide];
        prev.classList.remove('is-visible');
        /* si avanzamos, salida hacia arriba; si retrocedemos, hacia abajo */
        if (next > activeSlide) {
          prev.classList.add('is-exiting');
          setTimeout(() => prev.classList.remove('is-exiting'), 550);
        }
      }

      /* mostrar el siguiente */
      if (next >= 0 && slides[next]) {
        slides[next].classList.remove('is-exiting');
        /* pequeño delay para que la salida sea visible */
        requestAnimationFrame(() => {
          slides[next]?.classList.add('is-visible');
        });
      }

      activeSlide = next;
    }

    function tick() {
      raf = requestAnimationFrame(tick);

      const dur = video!.duration;
      if (!dur || isNaN(dur)) return;

      const p = progress();

      /* video scrub — lerp adaptativo:
         delta grande → lerp más alto (rueda rápida)
         delta pequeño → lerp más suave (barra o trackpad lento) */
      target  = p * dur;
      const delta = Math.abs(target - current);
      const lerp  = delta > 1.5
        ? 0.30          // rueda rápida: perseguir agresivo
        : delta > 0.4
          ? 0.18        // rueda normal
          : 0.10;       // barra / trackpad: suave
      current = current + (target - current) * lerp;

      if (!seeking && Math.abs(current - video!.currentTime) >= THRESH) {
        seeking = true;
        video!.currentTime = current;
      }

      /* slides */
      updateSlides(p);
    }

    video.addEventListener('seeked', () => { seeking = false; });

    function boot() {
      current = progress() * (video!.duration || 0);
      target  = current;
      updateSlides(progress());
      if (raf === null) raf = requestAnimationFrame(tick);
    }

    if (video.readyState >= 1) {
      boot();
    } else {
      video.addEventListener('loadedmetadata', boot, { once: true });
    }
  })();
</script>
