---
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Lumière One — A camera engineered for those who see differently. Full-frame. Hand-assembled. Uncompromising." />
    <meta name="theme-color" content="#06080d" />
    <title>Lumière — See what others miss.</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=DM+Mono:wght@300;400&display=swap" rel="stylesheet" />
  </head>

  <body>

    <!-- ══════════════════════════════════════════════════════════════ -->
    <!--  NAV (fuera del hero, sticky independiente)                   -->
    <!-- ══════════════════════════════════════════════════════════════ -->
    <nav class="site-nav" aria-label="Main navigation">
      <div class="nav-brand">
        <span class="brand-mark" aria-hidden="true">◈</span>
        <span class="brand-name">Lumière</span>
      </div>
      <div class="nav-links">
        <a href="#vision" class="nav-link">Vision</a>
        <a href="#craft" class="nav-link">Craft</a>
        <a href="#specs" class="nav-link">Specs</a>
        <a href="#acquire" class="nav-cta">Acquire</a>
      </div>
    </nav>

    <!-- ══════════════════════════════════════════════════════════════ -->
    <!--  SCROLL VIDEO HERO                                             -->
    <!-- ══════════════════════════════════════════════════════════════ -->
    <section
      id="hero"
      class="scroll-hero-container"
      aria-label="Lumière One hero — scroll to assemble the camera"
    >
      <div class="scroll-hero-sticky">

        <video
          id="hero-video"
          src="/videos/camera.mp4"
          muted
          playsinline
          preload="auto"
          aria-hidden="true"
        ></video>

        <!-- Vignette overlays -->
        <div class="overlay overlay-bottom" aria-hidden="true"></div>
        <div class="overlay overlay-top"    aria-hidden="true"></div>
        <div class="overlay overlay-sides"  aria-hidden="true"></div>
        <div class="grain" aria-hidden="true"></div>

        <!-- ── Slide 0: apertura ─────────────────────────────── -->
        <div class="hero-slide" data-slide="0" aria-hidden="true">
          <p class="slide-eyebrow">Issue I — Limited Run · 2025</p>
          <h1 class="slide-headline">
            See what<br /><em>others miss.</em>
          </h1>
          <p class="slide-sub">
            A full-frame camera hand-assembled<br />
            for photographers who refuse to compromise.
          </p>
          <div class="slide-scroll-hint">
            <div class="scroll-line"></div>
            <span class="scroll-label">Scroll to reveal</span>
          </div>
        </div>

        <!-- ── Slide 1: sensor ───────────────────────────────── -->
        <div class="hero-slide" data-slide="1" aria-hidden="true">
          <p class="slide-tag">Luminary Sensor</p>
          <div class="slide-big-stat">
            <span class="big-n">61</span>
            <span class="big-u">MP</span>
          </div>
          <p class="slide-stat-desc">
            Back-illuminated full-frame BSI CMOS.<br />
            15.3 stops of dynamic range. ISO&nbsp;100–102400.
          </p>
        </div>

        <!-- ── Slide 2: IBIS ─────────────────────────────────── -->
        <div class="hero-slide" data-slide="2" aria-hidden="true">
          <p class="slide-tag">In-Body Stabilisation</p>
          <div class="slide-big-stat">
            <span class="big-n">8</span>
            <span class="big-u">stops</span>
          </div>
          <p class="slide-stat-desc">
            Five-axis IBIS. Sharp at 1/4&nbsp;s.<br />
            Hand-held, wide-angle, no excuses.
          </p>
        </div>

        <!-- ── Slide 3: burst ────────────────────────────────── -->
        <div class="hero-slide" data-slide="3" aria-hidden="true">
          <p class="slide-tag">Burst Speed</p>
          <div class="slide-big-stat">
            <span class="big-n">20</span>
            <span class="big-u">fps</span>
          </div>
          <p class="slide-stat-desc">
            Mechanical shutter. 30&nbsp;fps electronic.<br />
            Neural AF tracking at 120&nbsp;fps.
          </p>
        </div>

        <!-- ── Slide 4: CTA ──────────────────────────────────── -->
        <div class="hero-slide" data-slide="4" aria-hidden="true">
          <p class="slide-eyebrow">300 units worldwide</p>
          <h2 class="slide-headline slide-headline--cta">
            Your camera<br /><em>awaits.</em>
          </h2>
          <div class="slide-cta-actions">
            <a href="#acquire" class="btn-primary">Reserve yours — $6,499</a>
            <a href="#vision"  class="btn-ghost">Explore the camera</a>
          </div>
        </div>

      </div>
    </section>

    <!-- ══════════════════════════════════════════════════════════════ -->
    <!--  VISION                                                        -->
    <!-- ══════════════════════════════════════════════════════════════ -->
    <section id="vision" class="vision-section" aria-labelledby="vision-heading">
      <div class="section-inner">
        <div class="vision-grid">
          <div class="vision-label">
            <span class="section-tag">01 — Vision</span>
            <div class="tag-rule" aria-hidden="true"></div>
          </div>
          <div class="vision-copy">
            <h2 id="vision-heading" class="section-heading">
              Light is<br /><em>information.</em><br />Capture all of it.
            </h2>
            <div class="vision-text-cols">
              <p class="body-p">
                Lumière One was born from a single obsession: what does a camera
                look like when engineers and artists refuse to separate their
                disciplines? The answer is a machine that disappears in your hands
                and leaves only the image.
              </p>
              <p class="body-p">
                Every component is chosen with the same rigour a watchmaker applies
                to a movement. No plastic. No compromise. No excuses. Just glass,
                light, and 61 million points of truth captured in a fraction
                of a second.
              </p>
            </div>
          </div>
        </div>
      </div>

      <div class="pull-quote-wrap">
        <blockquote class="pull-quote">
          "Not a tool. A collaborator."
          <cite class="pull-cite">— Lumière design brief, 2024</cite>
        </blockquote>
      </div>
    </section>

    <!-- ══════════════════════════════════════════════════════════════ -->
    <!--  CRAFT                                                         -->
    <!-- ══════════════════════════════════════════════════════════════ -->
    <section id="craft" class="craft-section" aria-labelledby="craft-heading">
      <div class="section-inner">
        <div class="section-header">
          <span class="section-tag">02 — Craft</span>
          <h2 id="craft-heading" class="section-heading">
            Engineered to the<br />last photon.
          </h2>
        </div>

        <div class="craft-grid">

          <article class="craft-card craft-card--wide">
            <div class="craft-card-top">
              <div class="craft-card-icon" aria-hidden="true">
                <svg width="26" height="26" viewBox="0 0 26 26" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="13" cy="13" r="5"/><circle cx="13" cy="13" r="10"/>
                  <line x1="13" y1="3" x2="13" y2="1"/><line x1="13" y1="25" x2="13" y2="23"/>
                  <line x1="3" y1="13" x2="1" y2="13"/><line x1="25" y1="13" x2="23" y2="13"/>
                </svg>
              </div>
              <h3 class="craft-title">Luminary Sensor</h3>
            </div>
            <p class="craft-body">
              A back-illuminated 61MP full-frame sensor developed exclusively with
              Sony Semiconductor. Dual-gain architecture captures 15.3 stops of
              dynamic range — shadow detail so clean you'll question whether it's real.
              ISO 100–102400 native. The sensor that redefines what low-light photography means.
            </p>
            <div class="craft-spec">
              <span class="spec-key">Dynamic range</span>
              <span class="spec-val">15.3 stops</span>
            </div>
          </article>

          <article class="craft-card">
            <div class="craft-card-top">
              <div class="craft-card-icon" aria-hidden="true">
                <svg width="26" height="26" viewBox="0 0 26 26" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="3" width="20" height="20" rx="2"/>
                  <path d="M3 9h20M9 23V9"/>
                </svg>
              </div>
              <h3 class="craft-title">Titanium Frame</h3>
            </div>
            <p class="craft-body">
              Grade 5 titanium body machined from a solid billet. Lighter than
              aluminium at equivalent stiffness. Every surface milled with ±0.01mm
              tolerance. Built to outlast careers.
            </p>
            <div class="craft-spec">
              <span class="spec-key">Material</span>
              <span class="spec-val">Grade 5 Ti</span>
            </div>
          </article>

          <article class="craft-card">
            <div class="craft-card-top">
              <div class="craft-card-icon" aria-hidden="true">
                <svg width="26" height="26" viewBox="0 0 26 26" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M13 3L3 9v8l10 6 10-6V9L13 3z"/>
                  <path d="M13 3v16M3 9l10 6 10-6"/>
                </svg>
              </div>
              <h3 class="craft-title">Neural AF Engine</h3>
            </div>
            <p class="craft-body">
              Real-time subject detection running at 120fps on a dedicated neural
              accelerator. Tracks eyes, faces, birds, vehicles and motion patterns
              with sub-frame latency. Focus that thinks ahead of you.
            </p>
            <div class="craft-spec">
              <span class="spec-key">AF coverage</span>
              <span class="spec-val">100% frame</span>
            </div>
          </article>

          <article class="craft-card craft-card--accent">
            <div class="craft-card-top">
              <div class="craft-card-icon" aria-hidden="true">
                <svg width="26" height="26" viewBox="0 0 26 26" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="13" cy="13" r="9"/>
                  <path d="M13 7v6l4 2"/>
                </svg>
              </div>
              <h3 class="craft-title">8-Stop IBIS</h3>
            </div>
            <p class="craft-body">
              In-body image stabilisation that compensates across 5 axes simultaneously.
              Hand-held at 1/4s wide-angle. Sharp where others blur.
            </p>
            <div class="craft-spec">
              <span class="spec-key">Compensation</span>
              <span class="spec-val">8.0 stops</span>
            </div>
          </article>

        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════════════════════════════ -->
    <!--  SPECS                                                         -->
    <!-- ══════════════════════════════════════════════════════════════ -->
    <section id="specs" class="specs-section" aria-labelledby="specs-heading">
      <div class="section-inner">
        <div class="specs-header">
          <div>
            <span class="section-tag">03 — Specifications</span>
            <h2 id="specs-heading" class="section-heading">The numbers.</h2>
          </div>
          <p class="body-p specs-intro">
            Every figure earned through engineering discipline, not marketing
            arithmetic. These are the real numbers.
          </p>
        </div>

        <div class="specs-table" role="table" aria-label="Lumière One specifications">
          {[
            ["Sensor",          "61.2MP BSI full-frame CMOS (36×24mm)"],
            ["Processor",       "Lumière PRIME IV + Neural Accelerator"],
            ["ISO range",       "100–102400 (expandable 50–204800)"],
            ["Dynamic range",   "15.3 stops (dual gain)"],
            ["AF system",       "759-point phase-detect, 100% coverage"],
            ["Burst speed",     "20fps mechanical / 30fps electronic"],
            ["Video",           "8K RAW · 4K 120fps · ProRes HQ"],
            ["IBIS",            "8.0-stop compensation, 5-axis"],
            ["Viewfinder",      "0.9× OLED, 11.36MP, 240fps refresh"],
            ["Body",            "Grade 5 titanium + magnesium alloy"],
            ["Sealing",         "IPX6 dust and weather sealed"],
            ["Battery",         "NP-FZ200 · ≈900 shots CIPA"],
            ["Connectivity",    "USB4 80Gbps · HDMI 2.1 · CFexpress B"],
            ["Dimensions",      "139 × 97 × 81 mm"],
            ["Weight",          "689g body only"],
            ["Warranty",        "3 years frame · 1 year sensor"],
          ].map(([label, value]) => (
            <div class="spec-row" role="row">
              <span class="spec-row-label" role="rowheader">{label}</span>
              <span class="spec-row-value" role="cell">{value}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════════════════════════════ -->
    <!--  ACQUIRE / CTA                                                 -->
    <!-- ══════════════════════════════════════════════════════════════ -->
    <section id="acquire" class="acquire-section" aria-labelledby="acquire-heading">
      <div class="acquire-glow" aria-hidden="true"></div>
      <div class="section-inner acquire-inner">
        <span class="section-tag" style="text-align:center; display:block;">04 — Acquire</span>
        <h2 id="acquire-heading" class="acquire-heading">
          Three hundred cameras.<br /><em>One for you.</em>
        </h2>
        <p class="body-p acquire-sub">
          Lumière One is produced in runs of 300. Each unit is individually
          numbered and calibrated before shipping. We do not rush. We do not
          cut corners. We ship when it is ready.
        </p>
        <div class="acquire-actions">
          <a href="#acquire-form" class="btn-primary btn-primary--large">Reserve — $6,499</a>
          <a href="#specs" class="btn-ghost">Full specifications</a>
        </div>
        <p class="acquire-note">
          No charge until production. Full refund until dispatch. Ships Q4 2025.
        </p>
      </div>
    </section>

    <!-- FOOTER -->
    <footer class="site-footer">
      <div class="section-inner footer-inner">
        <div class="footer-brand">
          <span class="brand-mark" style="color:rgba(160,180,210,0.4); font-size:0.85rem">◈</span>
          <span class="footer-brand-name">Lumière</span>
        </div>
        <p class="footer-legal">
          © 2025 Lumière Optical Co. All rights reserved. · Engineered without compromise.
        </p>
        <nav class="footer-nav" aria-label="Footer navigation">
          <a href="#vision" class="footer-link">Vision</a>
          <a href="#craft"  class="footer-link">Craft</a>
          <a href="#specs"  class="footer-link">Specs</a>
          <a href="#acquire" class="footer-link">Acquire</a>
        </nav>
      </div>
    </footer>

  </body>
</html>

<style>
  /* ─── Reset ─────────────────────────────────────────────────────── */
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --bg:          #06080d;
    --bg-1:        #0a0d14;
    --bg-2:        #0e121b;
    --ice:         #a8bcd8;
    --ice-dim:     rgba(168, 188, 216, 0.15);
    --paper:       #e8e4dc;
    --paper-dim:   rgba(232, 228, 220, 0.55);
    --paper-muted: rgba(232, 228, 220, 0.28);
    --border:      rgba(168, 188, 216, 0.1);
    --border-hi:   rgba(168, 188, 216, 0.22);
  }

  html {
    background: var(--bg);
    color: var(--paper);
    font-family: 'DM Mono', monospace;
    font-size: 16px;
    -webkit-font-smoothing: antialiased;
    scroll-behavior: smooth;
  }

  /* 2K / HiDPI — escalar base font para que todo crezca proporcionalmente */
  @media (min-width: 1920px) { html { font-size: 19px; } }
  @media (min-width: 2400px) { html { font-size: 22px; } }
  body { background: var(--bg); overflow-x: hidden; }
  em   { font-style: italic; }
  a    { text-decoration: none; color: inherit; }

  /* ─── Shared layout ─────────────────────────────────────────────── */
  .section-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 2.5rem;
  }
  @media (min-width: 768px) { .section-inner { padding: 0 5vw; } }

  .section-tag {
    display: block;
    font-family: 'DM Mono', monospace;
    font-size: clamp(0.7rem, 0.9vw, 1rem);
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--ice);
    opacity: 0.55;
    margin-bottom: 1.25rem;
  }

  .section-heading {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(2.8rem, 4.5vw, 5.5rem);
    font-weight: 300;
    line-height: 1.08;
    letter-spacing: -0.01em;
    color: var(--paper);
  }
  .section-heading em { font-style: italic; color: var(--ice); }

  .body-p {
    font-family: 'DM Mono', monospace;
    font-size: clamp(0.85rem, 1vw, 1.05rem);
    font-weight: 300;
    line-height: 1.9;
    color: var(--paper-dim);
  }

  /* ─── Buttons ───────────────────────────────────────────────────── */
  .btn-primary {
    display: inline-flex;
    align-items: center;
    padding: 0.85rem 1.75rem;
    background: var(--ice);
    color: var(--bg);
    font-family: 'DM Mono', monospace;
    font-size: 0.68rem;
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    transition: background 0.2s, transform 0.15s;
  }
  .btn-primary:hover { background: #c4d4ea; transform: translateY(-1px); }
  .btn-primary--large { padding: 1.05rem 2.25rem; font-size: 0.72rem; }

  .btn-ghost {
    display: inline-flex;
    align-items: center;
    padding: 0.85rem 1.75rem;
    border: 1px solid var(--border-hi);
    color: var(--paper-dim);
    font-family: 'DM Mono', monospace;
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    transition: border-color 0.2s, color 0.2s;
  }
  .btn-ghost:hover { border-color: var(--ice); color: var(--ice); }

  /* ═══════════════════════════════════════════════════════════════════
     NAV
  ════════════════════════════════════════════════════════════════════ */
  .site-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.5rem 2.5rem;
    background: linear-gradient(to bottom, rgba(6,8,13,0.85) 0%, transparent 100%);
    backdrop-filter: blur(0px);
    pointer-events: none; /* deja el scroll pasar */
  }
  @media (min-width: 768px) { .site-nav { padding: 1.75rem 5vw; } }
  /* habilitar clicks solo en los hijos */
  .site-nav > * { pointer-events: auto; }

  .nav-brand { display: flex; align-items: center; gap: 0.6rem; }
  .brand-mark { color: var(--ice); font-size: 0.9rem; opacity: 0.65; }
  .brand-name {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1rem;
    font-weight: 300;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--paper);
  }

  .nav-links { display: none; align-items: center; gap: 2rem; }
  @media (min-width: 768px) { .nav-links { display: flex; } }

  .nav-link {
    font-family: 'DM Mono', monospace;
    font-size: 0.6rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--paper-muted);
    transition: color 0.2s;
  }
  .nav-link:hover { color: var(--ice); }

  .nav-cta {
    font-family: 'DM Mono', monospace;
    font-size: 0.6rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ice);
    padding: 0.4rem 0.85rem;
    border: 1px solid rgba(168, 188, 216, 0.28);
    transition: background 0.2s, color 0.2s;
  }
  .nav-cta:hover { background: var(--ice); color: var(--bg); }

  /* ═══════════════════════════════════════════════════════════════════
     SCROLL VIDEO HERO
  ════════════════════════════════════════════════════════════════════ */
  .scroll-hero-container {
    position: relative;
    height: 600vh; /* 5 slides × 120vh de "tiempo" */
  }

  .scroll-hero-sticky {
    position: sticky;
    top: 0;
    width: 100%;
    height: 100vh;
    overflow: hidden;
    background: #06080d;
  }

  #hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  /* overlays */
  .overlay { position: absolute; inset: 0; pointer-events: none; }
  .overlay-bottom {
    background: linear-gradient(to top,
      rgba(6,8,13,0.92) 0%,
      rgba(6,8,13,0.45) 30%,
      transparent 55%);
  }
  .overlay-top {
    background: linear-gradient(to bottom,
      rgba(6,8,13,0.7) 0%,
      transparent 18%);
  }
  .overlay-sides {
    background: linear-gradient(to right,
      rgba(6,8,13,0.35) 0%,
      transparent 35%,
      transparent 65%,
      rgba(6,8,13,0.2) 100%);
  }

  /* grain */
  .grain {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.03;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    background-size: 200px;
  }

  /* ── Slides ──────────────────────────────────────────────────────── */
  .hero-slide {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 6rem 2rem 4rem;
    opacity: 0;
    /* transiciones independientes entrada/salida via JS class */
    transition: opacity 0.55s cubic-bezier(0.4, 0, 0.2, 1),
                transform 0.55s cubic-bezier(0.4, 0, 0.2, 1);
    transform: translateY(24px);
    pointer-events: none;
  }
  .hero-slide.is-visible {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }
  .hero-slide.is-exiting {
    opacity: 0;
    transform: translateY(-20px);
  }

  /* slide 0 */
  .slide-eyebrow {
    font-family: 'DM Mono', monospace;
    font-size: clamp(0.7rem, 0.85vw, 1rem);
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--ice);
    opacity: 0.55;
    margin-bottom: 1.75rem;
  }
  .slide-headline {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(3.5rem, 7vw, 8rem);
    font-weight: 300;
    line-height: 1.04;
    letter-spacing: -0.01em;
    color: var(--paper);
    margin-bottom: 1.5rem;
  }
  .slide-headline em { color: var(--ice); }
  .slide-headline--cta { font-size: clamp(2.8rem, 6vw, 5.5rem); }

  .slide-sub {
    font-family: 'DM Mono', monospace;
