<script>
  (function () {
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const video     = document.getElementById('hero-video') as HTMLVideoElement | null;
    const container = document.getElementById('hero') as HTMLElement | null;
    if (!video || !container) return;

    const slides = Array.from(
      container.querySelectorAll<HTMLElement>('.hero-slide')
    );

    /* ── Reduced motion: sólo slide 0 visible ─────────────────── */
    if (prefersReduced) {
      video.loop = true;
      video.play().catch(() => {});
      slides[0]?.classList.add('is-visible');
      return;
    }

    /* ─────────────────────────────────────────────────────────────
       SCROLL SCRUB — lerp adaptativo + decode-gate
       (mismo patrón probado en camera y keyforge landing)
    ───────────────────────────────────────────────────────────── */
    const THRESH = 0.025;

    let target  = 0;
    let current = 0;
    let seeking = false;
    let raf: number | null = null;

    /*
      5 slides distribuidos en el rango 0–1 de scroll:
      Slide 0 (apertura):   0.00 – 0.14
      Slide 1 (chip):       0.19 – 0.38
      Slide 2 (camera):     0.44 – 0.60
      Slide 3 (titanio):    0.66 – 0.80
      Slide 4 (CTA):        0.87 – 1.00
    */
    const SLIDE_RANGES: [number, number][] = [
      [0.00, 0.14],
      [0.19, 0.38],
      [0.44, 0.60],
      [0.66, 0.80],
      [0.87, 1.00],
    ];

    let activeSlide = -1;

    function progress(): number {
      const rect  = container!.getBoundingClientRect();
      const range = container!.offsetHeight - window.innerHeight;
      if (range <= 0) return 0;
      return Math.min(Math.max(-rect.top / range, 0), 1);
    }

    function updateSlides(p: number) {
      let next = -1;
      for (let i = 0; i < SLIDE_RANGES.length; i++) {
        const [start, end] = SLIDE_RANGES[i];
        if (p >= start && p <= end) { next = i; break; }
      }

      if (next === activeSlide) return;

      if (activeSlide >= 0 && slides[activeSlide]) {
        const prev = slides[activeSlide];
        prev.classList.remove('is-visible');
        if (next > activeSlide) {
          prev.classList.add('is-exiting');
          setTimeout(() => prev.classList.remove('is-exiting'), 500);
        }
      }

      if (next >= 0 && slides[next]) {
        slides[next].classList.remove('is-exiting');
        requestAnimationFrame(() => {
          slides[next]?.classList.add('is-visible');
        });
      }

      activeSlide = next;
    }

    function tick() {
      raf = requestAnimationFrame(tick);

      const dur = video!.duration;
      if (!dur || isNaN(dur)) return;

      const p = progress();

      target  = p * dur;
      const delta = Math.abs(target - current);
      const lerp  = delta > 1.5 ? 0.30 : delta > 0.4 ? 0.18 : 0.10;
      current = current + (target - current) * lerp;

      if (!seeking && Math.abs(current - video!.currentTime) >= THRESH) {
        seeking = true;
        video!.currentTime = current;
      }

      updateSlides(p);
    }

    video.addEventListener('seeked', () => { seeking = false; });

    function boot() {
      current = progress() * (video!.duration || 0);
      target  = current;
      updateSlides(progress());
      if (raf === null) raf = requestAnimationFrame(tick);
    }

    if (video.readyState >= 1) {
      boot();
    } else {
      video.addEventListener('loadedmetadata', boot, { once: true });
    }

    /* ── Nav: cambiar a modo claro cuando llegamos a features ─── */
    const nav      = document.getElementById('apple-nav');
    const features = document.getElementById('features');

    if (nav && features) {
      const observer = new IntersectionObserver(
        ([entry]) => {
          nav.classList.toggle('nav--light', entry.isIntersecting);
        },
        { rootMargin: '-44px 0px 0px 0px', threshold: 0 }
      );
      observer.observe(features);
    }
  })();
</script>
